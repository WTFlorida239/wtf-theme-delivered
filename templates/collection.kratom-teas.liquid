{% comment %}
Collection Template — Kratom Teas (Homepage card style)
Renders a responsive card grid using centralized item data.
{% endcomment %}

{% render 'wtf-drink-data' %}
{%- capture items_json -%}{% render 'wtf-kratom-data' %}{%- endcapture -%}
{%- # theme-check-disable UnknownFilter -%}
{%- # theme-check-disable UnusedAssign -%}
{% assign kratom_items = items_json | parse_json %}
{%- # theme-check-enable UnusedAssign -%}
{%- # theme-check-enable UnknownFilter -%}
{% render 'wtf-collection-cards', title: collection.title, default: 'Kratom Teas', subtitle: 'Green, Red, White & Yellow strains with premium flavorings', items: kratom_items, color: 'kratom', back_url: routes.root_url %}
